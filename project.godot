; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LeafSweeper"
config/description="A cozy puzzle game about sweeping forest-floor debris to find the hidden bug."
config/version="0.0.1"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://assets/icons/app_icon.png"
; hide the Godot boot logo; fade from the floor brown (#3d3223) straight into the game
boot_splash/show_image=false
boot_splash/bg_color=Color(0.239216, 0.196078, 0.137255, 1)

[display]

window/size/viewport_width=1080
window/size/viewport_height=2340
window/size/window_width_override=540
window/size/window_height_override=1170
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="LeafSweeper"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
